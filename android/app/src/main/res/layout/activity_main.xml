<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0F12"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trade Bot"
            android:textColor="#E6E9EE"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Testnet · sahte para"
            android:textColor="#7C8594"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/runState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#E6E9EE"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="Durum yükleniyor..." />

        <TextView
            android:id="@+id/runDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#7C8594"
            android:textSize="13sp" />

        <Button
            android:id="@+id/runBot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Botu çalıştır (5,5 saat)"
            android:textColor="#A8FF3E" />

        <Button
            android:id="@+id/testRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Test çalıştırması (1 dakika)" />

        <Button
            android:id="@+id/refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Durumu yenile" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="BOT VERİSİ"
            android:textColor="#7C8594"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/botData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#E6E9EE"
            android:textSize="14sp"
            android:text="Henüz veri yok. Bot bir çalışmayı bitirince burada görünür." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="GITHUB TOKEN"
            android:textColor="#7C8594"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="github_pat_... (sadece bu repo için)"
            android:inputType="textPassword"
            android:textColor="#E6E9EE"
            android:textColorHint="#4A5160" />

        <Button
            android:id="@+id/saveToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Token'ı kaydet" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Bot GitHub'da çalışır ve süre dolunca durur. Açık pozisyonlar bot çalışmıyorken korunmaz. Sadece testnet."
            android:textColor="#7C8594"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
