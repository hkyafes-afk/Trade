# Sadece testnet. Gerçek anahtarları bu dosyaya koyma.
BOT_ENV=testnet
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

SYMBOL=BTCUSDT
INTERVAL=1m
FAST_MA=10
SLOW_MA=30
POLL_SECONDS=60

# Risk sınırları (USDT)
MAX_ORDER_USDT=20
MAX_DAILY_LOSS_USDT=10
MAX_POSITION_USDT=50

# true: emir göndermez, sadece kaydeder. Testnet'te önce bunu kullan.
DRY_RUN=true

DB_PATH=data/ledger.sqlite
KILL_SWITCH_FILE=data/KILL
